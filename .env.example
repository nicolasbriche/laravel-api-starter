###############################################################################
# APPLICATION
###############################################################################
APP_NAME="Laravel API Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# URL publique de l'API. En dev Docker : http://localhost:8080
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Coût du hachage bcrypt. 12 en prod, 4 en test (voir phpunit.xml)
BCRYPT_ROUNDS=12

###############################################################################
# API
###############################################################################
# Version affichée dans la documentation OpenAPI (/docs/api)
API_VERSION=1.0.0

# Nombre maximum de requêtes par minute et par utilisateur (ou IP si invité)
# Voir config/app.php -> api_rate_limit
API_RATE_LIMIT=60

# Domaines autorisés à appeler l'API depuis un navigateur (CORS).
# Liste séparée par des virgules. Utiliser * pour tout autoriser (dev uniquement).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Domaines considérés comme "stateful" par Sanctum (auth par cookie SPA).
# Pour une auth par token uniquement (mobile/API), cette variable est peu utilisée.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8080,localhost:8080

###############################################################################
# LOGGING
###############################################################################
# daily = un fichier de log par jour (recommandé)
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug en dev, warning ou error en production
LOG_LEVEL=debug
# Nombre de jours de logs conservés avec le driver "daily"
LOG_DAILY_DAYS=14

###############################################################################
# BASE DE DONNÉES
###############################################################################
# En dev : SQLite (fichier database/database.sqlite, créé par `touch`)
# En prod : passer à mysql ou pgsql et décommenter les lignes ci-dessous
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

###############################################################################
# SESSION / CACHE / QUEUE
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

###############################################################################
# REDIS (optionnel — recommandé en production pour cache/queue/rate limiting)
###############################################################################
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

###############################################################################
# MAIL
###############################################################################
# log = les emails sont écrits dans les logs au lieu d'être envoyés (dev)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# AWS (optionnel — stockage S3)
###############################################################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false